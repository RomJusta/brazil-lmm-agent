# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/brazil_lmm

# Google Sheets export (optional)
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
GOOGLE_SHEET_ID=your_sheet_id

# BuiltWith API (optional — free tier available)
BUILTWITH_API_KEY=

# LinkedIn session cookie (required for LinkedIn enrichment)
# Log in via browser, copy the li_at cookie value
LINKEDIN_LI_AT_COOKIE=

# Rate limiting
REQUESTS_PER_SECOND=2
